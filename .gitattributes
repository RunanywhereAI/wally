# The pinned contract is hashed byte-for-byte against a SHA-256 baked into
# console_contract.h at generation time (see test_wally_contract.cpp). Windows
# runners default to core.autocrlf=true, which rewrites LF to CRLF on checkout
# and breaks that hash. Keep it untouched on every platform.
contracts/wally-cli-v1.openapi.json -text
# The golden CLI corpus is compared byte for byte (tests/cli_golden.rs and
# cli_formatter's own fixture tests); a CRLF checkout would fail every case.
tests/golden/** -text
