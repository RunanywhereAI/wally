# wally build configuration — local file, never committed.
#
# Copy `.env.example` to `.env` and fill in the two console endpoints.
# Read by cmake/env-loader.cmake at configure time. Configure fails without
# these; the values end up compiled into the binary, so they never appear in
# committed source or on a command line.

# The control plane: /auth/cli/*, /v1/me, /v1/cli/*.
WALLY_BAKED_CONSOLE_API_URL=

# The browser origin allowed to host the approval page.
WALLY_BAKED_CONSOLE_WEB_ORIGIN=

# Optional: one more browser origin allowed to host the approval page, for a
# deployment that answers under a second name.
#WALLY_BAKED_CONSOLE_WEB_ORIGIN_ALT=
