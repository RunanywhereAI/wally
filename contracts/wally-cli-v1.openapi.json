      },
      "CancelRequestHeaderAuthorizationValue": {
        "default": "",
        "maxLength": 8192,
        "title": "Authorization",
        "type": "string"
      },
      "CancelRequestPathRequestIdValue": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9._:-]+$",
        "title": "Request Id",
        "type": "string"
      },
      "CancelRequestResponse": {
        "additionalProperties": false,
        "description": "Answer to a cancel that reached an in-flight request the caller owns.\n\n`status` is \"cancelling\", not \"cancelled\": the node has ended the request's\ncontext and told the engine to abort; the stream's own end and its\nsettlement follow a moment later on their own path.",
        "properties": {
          "request_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Request Id",
            "type": "string"
          },
          "status": {
            "const": "cancelling",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "request_id",
          "status"
        ],
        "title": "CancelRequestResponse",
        "type": "object"
      },
      "CatalogModelResponse": {
        "additionalProperties": false,
        "description": "One entitled model, priced. Straight from `pricing.catalog()` - the same\nnumbers the credit gate charges against, so a published price cannot drift\nfrom a billed one (G7).",
        "properties": {
          "cached_input_per_mtok": {
            "maximum": 9007199254740991.0,
            "minimum": 0.0,
            "title": "Cached Input Per Mtok",
            "type": "integer"
          },
          "display_name": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Display Name",
            "type": "string"
          },
          "id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
            "title": "Id",
            "type": "string"
          },
          "input_per_mtok": {
            "maximum": 9007199254740991.0,
            "minimum": 0.0,
            "title": "Input Per Mtok",
            "type": "integer"
          },
          "output_per_mtok": {
            "maximum": 9007199254740991.0,
            "minimum": 0.0,
            "title": "Output Per Mtok",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "display_name",
          "input_per_mtok",
          "output_per_mtok",
          "cached_input_per_mtok"
        ],
        "title": "CatalogModelResponse",
        "type": "object"
      },
      "CliClient": {
        "enum": [
